# Copy this file, name the copy ".env", and put your own values in it.

# PostgreSQL address: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Replace YOUR_PASSWORD with the password you chose when installing PostgreSQL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/burncare

# Any long random text. It protects the login cookie.
SECRET_KEY=burncare-change-this-to-a-long-random-text

# Email for the admin login code.
# While developing, leave MAIL_SERVER empty: the 6-digit code is then
# printed in the terminal where Flask is running.
MAIL_SERVER=
# Later, to send real emails with Gmail, fill these in instead
# (MAIL_PASSWORD must be a Gmail "App password", not your normal password):
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=burncare.project@gmail.com
# MAIL_PASSWORD=your-16-letter-app-password
# MAIL_FROM=BurnCare <burncare.project@gmail.com>
